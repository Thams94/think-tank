{
  "name": "ai-group-chat",
  "version": "0.5.3",
  "description": "智库：多模型审核工作台，自动组建审核团队并按议题逐项推进",
  "main": "main.js",
  "author": "local",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "selftest": "node tools/selftest.js",
    "pack": "electron-packager . \"AI群聊\" --platform=win32 --arch=x64 --out=dist --asar --overwrite --ignore=\"^/tools\" --ignore=\"^/dist\"",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.harness.aigroupchat",
    "productName": "智库",
    "copyright": "© 2026",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "tools/ocr.ps1",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "智库-安装程序-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "智库",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "asarUnpack": [
      "**/node_modules/pdf-parse/**"
    ]
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5"
  }
}